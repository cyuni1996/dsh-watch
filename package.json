{
  "name": "dsh-watch",
  "version": "0.1.16",
  "description": "Continue DeepSeek Harness sessions on a round Android watch.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wear-os"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-watch-pair": "./plugin/pair.js"
  },
  "files": [
    "plugin/*.js",
    "plugin/serena.py",
    "packaging/prebuilt/dsh-watch.apk",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test plugin/*.test.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyuni1996/dsh-watch.git"
  },
  "homepage": "https://github.com/cyuni1996/dsh-watch",
  "bugs": {
    "url": "https://github.com/cyuni1996/dsh-watch/issues"
  }
}
